+            and language_packed_seq_params.cu_seqlens_q_padded is not None
+            and language_packed_seq_params.cu_seqlens_kv_padded is not None
+        ):
+            # Text-only CP=1 uses the ordinary text packer's convention: every
+            # sample includes its trailing alignment tokens in attention's
+            # sequence length. This keeps the attention output in the same
+            # physical THD layout as the residual stream under TP/SP. Distinct
+            # padded boundaries still prevent attention/Mamba state from
+            # crossing samples; causal valid tokens cannot see their trailing
+            # padding. Keep logical lengths and masks intact for the caller's
+            # unpadding/loss code by changing only this language-model copy.
+            # Restrict this to PP=1: later PP stages may have no media payloads
+            # even for multimodal inputs, so they cannot infer text-only.
+            language_packed_seq_params = replace(
