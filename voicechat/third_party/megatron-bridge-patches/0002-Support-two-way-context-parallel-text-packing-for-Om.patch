-    def test_cp2_preserves_collator_metadata(self):
-        tokens, _, original = make_pack([3, 5], [4, 8])
+    def test_cp2_preserves_rank_tokens_labels_masks_and_causal_boundaries(self):
+        lengths, padded = [3, 5, 1], [4, 8, 4]
+        tokens, mask, original = make_pack(lengths, padded)
+        original_state = dict(vars(original))
+        expected_indices = ([0, 3, 4, 5, 10, 11, 12, 15], [1, 2, 6, 7, 8, 9, 13, 14])
+        rank_embeddings = []
+        full_embeddings = tokens.transpose(0, 1).unsqueeze(-1).float().repeat(1, 1, 3)
+        boundaries = original.cu_seqlens_q_padded.tolist()
+        packed_attention = torch.cat(
+            [causal_attention(full_embeddings[a:b, 0]) for a, b in zip(boundaries[:-1], boundaries[1:])]
+        )
+        for rank in range(2):
+            model = BoundaryModel()
+            model.context_parallel_lm = 2
+            model.pg_collection = SimpleNamespace(cp=SimpleNamespace(size=lambda: 2, rank=lambda: rank))
+            index = cpu_cp_partition_indices(original.cu_seqlens_q_padded, tokens.shape[1], 2, rank)
+            self.assertEqual(index.tolist(), expected_indices[rank])
+            with patch(
+                "megatron.bridge.models.nemotron_omni.modeling_nemotron_omni.get_packed_seq_cp_partition_indices",
+                return_value=index,
+            ):
+                output, local_mask = model(
+                    input_ids=tokens, labels=tokens, loss_mask=mask, packed_seq_params=original
+                )
+            forwarded = model.language_model.last_kwargs["packed_seq_params"]
+            rank_embeddings.append(output)
+            self.assertIsNot(forwarded, original)
+            self.assertEqual(forwarded.cu_seqlens_q.tolist(), boundaries)
+            self.assertFalse(forwarded.pad_between_seqs)
+            self.assertEqual(output.shape[0], tokens.shape[1] // 2)
+            torch.testing.assert_close(output, full_embeddings.index_select(0, index))
+            torch.testing.assert_close(local_mask, mask.index_select(1, index))
+            torch.testing.assert_close(model.language_model.last_kwargs["labels"], tokens.index_select(1, index))
+            torch.testing.assert_close(forwarded.seq_idx, original.seq_idx)
+            # Each CP-local valid query still has exactly its own sample's
+            # causal prefix, including at a seam next to trailing padding.
+            for global_index in index.tolist():
+                if mask[0, global_index]:
+                    sample = int(forwarded.seq_idx[0, global_index])
+                    start = boundaries[sample]
+                    oracle = causal_attention(full_embeddings[start : global_index + 1, 0])[-1]
+                    torch.testing.assert_close(packed_attention[global_index], oracle)
+        for key, value in original_state.items():
+            self.assertIs(vars(original)[key], value, key)
+        self.assertEqual(sum(int(mask.index_select(1, torch.tensor(i)).sum()) for i in expected_indices), sum(lengths))
+        # Exercise the real Mamba CP pre/post permutation functions on CPU,
+        # substituting only TE's CUDA index primitive with the independent oracle.
+        gathered = torch.cat(rank_embeddings, dim=0)
+        with patch.object(mamba_context_parallel, "tex", SimpleNamespace(thd_get_partitioned_indices=cpu_cp_partition_indices)), patch.object(
+            mamba_context_parallel, "is_te_min_version", return_value=True
+        ):
+            restored = mamba_context_parallel._undo_attention_load_balancing(gathered, 2, forwarded)
+            torch.testing.assert_close(restored, full_embeddings)
+            reshuffled = mamba_context_parallel._redo_attention_load_balancing(restored, 2, forwarded)
+            torch.testing.assert_close(reshuffled, gathered)
+        # Treating the entire stream as one sample would leak prior samples.
+        dense = causal_attention(full_embeddings[:, 0])
+        self.assertFalse(torch.allclose(dense[boundaries[1]], packed_attention[boundaries[1]]))
+
+    def test_cp2_98k_physical_shape_and_mamba_reset_indices(self):
+        tokens, mask, original = make_pack([32759, 65533], [32768, 65536])
+        for rank in range(2):
+            model = BoundaryModel()
+            model.context_parallel_lm = 2
+            model.pg_collection = SimpleNamespace(cp=SimpleNamespace(size=lambda: 2, rank=lambda: rank))
+            index = cpu_cp_partition_indices(original.cu_seqlens_q_padded, 98304, 2, rank)
+            with patch(
+                "megatron.bridge.models.nemotron_omni.modeling_nemotron_omni.get_packed_seq_cp_partition_indices",
+                return_value=index,
+            ):
+                output, local_mask = model(input_ids=tokens, loss_mask=mask, packed_seq_params=original)
+            forwarded = model.language_model.last_kwargs["packed_seq_params"]
+            self.assertEqual(output.shape[0], 49152)
+            self.assertEqual(output.shape[0] % 4, 0)  # TP4 sequence parallel layout.
+            self.assertEqual(forwarded.cu_seqlens_q.tolist(), [0, 32768, 98304])
+            self.assertTrue(torch.all(forwarded.seq_idx[0, :32768] == 0))
+            self.assertTrue(torch.all(forwarded.seq_idx[0, 32768:] == 1))
+            torch.testing.assert_close(local_mask, mask.index_select(1, index))
+
