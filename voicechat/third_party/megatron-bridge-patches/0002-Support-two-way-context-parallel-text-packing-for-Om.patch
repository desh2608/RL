+def cpu_cp_partition_indices(cu_seqlens, total_tokens, cp_size, cp_rank):
+    """Independent per-sequence zigzag oracle; no CUDA/TE kernel is exercised."""
+    assert cp_size == 2
+    assert int(cu_seqlens[-1]) == total_tokens
+    pieces = []
+    for start, end in zip(cu_seqlens[:-1].tolist(), cu_seqlens[1:].tolist()):
+        assert (end - start) % (2 * cp_size) == 0
+        chunk = (end - start) // (2 * cp_size)
+        for chunk_index in (cp_rank, 2 * cp_size - cp_rank - 1):
+            pieces.append(torch.arange(start + chunk_index * chunk, start + (chunk_index + 1) * chunk))
+    return torch.cat(pieces)
+
+
 class TextOnlyPackingTests(unittest.TestCase):
     def test_observed_tp4_shape_and_original_metadata_and_loss_masks(self):
         # A witness with the failure's logical 16227 / physical 16384 totals.
@@ -153,15 +167,113 @@ class TextOnlyPackingTests(unittest.TestCase):
         self.assertIsNot(forwarded, original)
