+# Copyright (c) 2026, NVIDIA CORPORATION. All rights reserved.
+
+"""Learner-side processor adapter for trunk-compatible Omni audio."""
+
+import inspect
+
+from .nemo_audio_runtime import NemoAudioExtractor
+
+
+class NemoAudioProcessorAdapter:
+    """Preserve the checkpoint's prompt renderer and return learner mel tensors."""
+
+    def __init__(self, processor, sound_config) -> None:
+        self.processor = processor
+        self.feature_extractor = NemoAudioExtractor(sound_config)
+        # The Tau-Voice renderer uses these fields to expand audio placeholders.
+        if hasattr(processor, "audio_encoder_config"):
+            processor.audio_encoder_config = vars(self.feature_extractor.encoder_config).copy()
+            processor.audio_preprocessor_config = vars(self.feature_extractor.feature_config).copy()
+            processor.audio_sampling_rate = self.feature_extractor.sampling_rate
+        self._audio_argument = "audio" if "audio" in inspect.signature(processor.__call__).parameters else "audios"
+
+    def __getattr__(self, name):
+        processor = self.__dict__.get("processor")
+        if processor is None:
+            raise AttributeError(name)
+        return getattr(processor, name)
+
+    @property
+    def chat_template(self):
+        return self.processor.chat_template
+
+    @chat_template.setter
+    def chat_template(self, value):
+        self.processor.chat_template = value
+
+    @property
+    def model_input_names(self) -> list[str]:
+        return list(dict.fromkeys([*self.processor.model_input_names, "sound_clips", "sound_length"]))
+
+    def __call__(self, *args, **kwargs):
+        if self._audio_argument == "audios" and "audio" in kwargs:
+            kwargs["audios"] = kwargs.pop("audio")
+        waves = kwargs.get(self._audio_argument)
+        result = self.processor(*args, **kwargs)
+        if waves is not None:
+            # The source HF processor decodes paths and normalizes singleton
+            # arrays into a list. Reuse those waveforms instead of rereading
+            # caller input, whose NumPy truth value may be ambiguous.
+            decoded = result.get("sound_clips")
+            waveforms = decoded if isinstance(decoded, (list, tuple)) else waves
+            if not isinstance(waveforms, (list, tuple)):
+                waveforms = [waveforms]
+            result.pop("input_audio_features", None)
+            result.pop("feature_attention_mask", None)
+            result.pop("audio_num_clips", None)
+            result.update(self.feature_extractor(waveforms))
+        return result
+
+    def apply_chat_template(self, conversation, **kwargs):
+        if not kwargs.get("tokenize", True):
+            return self.processor.apply_chat_template(conversation, **kwargs)
+        waves = [
+            item["audio"]
+            for message in conversation
+            for item in message["content"]
+            if isinstance(message["content"], list) and item["type"] == "audio"
+        ]
+        if not waves:
+            return self.processor.apply_chat_template(conversation, **kwargs)
+        render_kwargs = {
+            key: value for key, value in kwargs.items() if key not in ("tokenize", "return_tensors", "return_dict")
+        }
+        text = self.processor.apply_chat_template(conversation, tokenize=False, **render_kwargs)
+        return self(text=text, **{self._audio_argument: waves}, return_tensors=kwargs.get("return_tensors", "pt"))
+
+
+# Direct imports make local Transformers dynamic-module reload self-contained.
+from .nemo_audio_config import NemoAudioFeatureConfig as _BridgeNemoAudioFeatureConfig  # noqa: E402, F401
+from .nemo_audio_preprocessing_standalone import (
+    AudioToMelSpectrogramPreprocessor as _BridgeAudioToMelSpectrogramPreprocessor,  # noqa: E402, F401
+)
+from .nemo_rope_transformer_encoder import RopeTransformerEncoder as _BridgeRopeTransformerEncoder  # noqa: E402, F401
+from .nemo_transformer_audio_model import NemoTransformerAudioModel as _BridgeNemoTransformerAudioModel  # noqa: E402, F401
+from .nemo_transformer_encoder import TransformerEncoder as _BridgeTransformerEncoder  # noqa: E402, F401
+from .packed_audio import PackedAudioEmbeddings as _BridgePackedAudioEmbeddings  # noqa: E402, F401
