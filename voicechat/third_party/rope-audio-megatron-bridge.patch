+# Copyright (c) 2026, NVIDIA CORPORATION. All rights reserved.
+
+"""Package Bridge-owned audio runtime assets in standalone Omni HF exports."""
+
+import ast
+import json
+import shutil
+from pathlib import Path
+
+
+def _ensure_processor_aliases(path: Path) -> None:
+    """Repair known historical processor labels without replacing their code."""
+    historical = {
+        "NemotronH_Nano_Omni_Reasoning_V3Processor": "NemotronNanoVLV2Processor",
+        "NemotronH_Nano_Omni_Reasoning_V3ImageProcessor": "NemotronNanoVLV2ImageProcessor",
+        "NemotronH_Nano_Omni_Reasoning_V3VideoProcessor": "NemotronNanoVLV2VideoProcessor",
+    }
+    for filename in ("config.json", "processor_config.json", "preprocessor_config.json"):
+        metadata_path = path / filename
+        if not metadata_path.is_file():
+            continue
+        metadata = json.loads(metadata_path.read_text())
+        for reference in metadata.get("auto_map", {}).values():
+            if not isinstance(reference, str) or "." not in reference:
+                continue
+            module, requested = reference.rsplit(".", 1)
+            previous = historical.get(requested)
+            source_path = path / f"{module}.py"
+            if previous is None or not source_path.is_file():
+                continue
+            source = source_path.read_text()
+            tree = ast.parse(source)
+            names = {node.name for node in tree.body if isinstance(node, ast.ClassDef)}
+            names.update(
+                target.id
+                for node in tree.body
+                if isinstance(node, ast.Assign)
+                for target in node.targets
+                if isinstance(target, ast.Name)
+            )
+            if requested not in names and previous in names:
+                source_path.write_text(source.rstrip() + f"\n\n{requested} = {previous}\n")
+
+
+def _ensure_sound_config_serialization(path: Path, config: dict) -> None:
+    """Keep the instance backend when HF serializes historical SoundConfig."""
+    reference = (config.get("auto_map") or {}).get("AutoConfig", "configuration.SoundConfig")
+    module = reference.rsplit(".", 1)[0]
+    source_path = path / f"{module}.py"
+    if not source_path.is_file():
+        return
+    source = source_path.read_text()
+    sound = next(
+        (node for node in ast.parse(source).body if isinstance(node, ast.ClassDef) and node.name == "SoundConfig"),
+        None,
+    )
+    if sound is None or any(isinstance(node, ast.FunctionDef) and node.name == "to_dict" for node in sound.body):
+        return
+    marker = "def _bridge_sound_config_to_dict(self):"
+    if marker not in source:
+        source_path.write_text(
+            source.rstrip()
+            + "\n\n"
+            + "\n".join(
+                [
+                    marker,
+                    "    config = PretrainedConfig.to_dict(self)",
+                    '    config["model_type"] = self.model_type',
+                    "    return config",
+                    "",
+                    "SoundConfig.to_dict = _bridge_sound_config_to_dict",
+                    "",
+                ]
+            )
+        )
+
+
+def export_nemo_audio_assets(path: Path, modeling_path: Path, *, sound_model_type: str | None = None) -> None:
+    """Install RoPE runtime modules without modifying Parakeet exports."""
+    config_path = path / "config.json"
+    if not config_path.is_file():
+        return
+    config = json.loads(config_path.read_text())
+    sound = config.get("sound_config") or {}
+    if sound_model_type == "nemo_transformer":
+        # HF's historical SoundConfig.to_dict writes its class label instead
+        # of the saved instance backend. Use the explicit source capability.
+        sound["model_type"] = sound_model_type
+        config["sound_config"] = sound
+        config_path.write_text(json.dumps(config, indent=2) + "\n")
+    if sound.get("model_type") != "nemo_transformer":
+        return
+    from .hf_audio.nemo_audio_runtime import audio_configs
+
+    audio_configs(sound)
+    _ensure_sound_config_serialization(path, config)
+    _ensure_processor_aliases(path)
+    assets = Path(__file__).parent / "hf_audio"
+    names = [file.name for file in assets.glob("*.py") if file.name != "__init__.py"]
+    for name in names:
+        shutil.copy2(assets / name, path / name)
+    audio_path = path / "audio_model.py"
+    if not audio_path.is_file():
+        raise FileNotFoundError("nemo_transformer export requires the source audio_model.py")
+    alias = "from .nemo_audio_runtime import NemoTransformerSoundEncoder"
+    source = audio_path.read_text()
+    if alias not in source:
+        audio_path.write_text(source.rstrip() + "\n\n" + alias + "\n")
+    # Transformers caches only directly visible relative imports. Expose every
+    # runtime dependency from the model's auto_map entrypoint on fresh reload.
+    imports = "\n".join(
+        f"from .{name} import {symbol} as _Bridge{symbol}"
+        for name, symbol in {
+            "nemo_audio_config": "NemoAudioFeatureConfig",
+            "nemo_audio_preprocessing_standalone": "AudioToMelSpectrogramPreprocessor",
+            "nemo_transformer_encoder": "TransformerEncoder",
+            "nemo_rope_transformer_encoder": "RopeTransformerEncoder",
+            "packed_audio": "PackedAudioEmbeddings",
+            "nemo_transformer_audio_model": "NemoTransformerAudioModel",
+            "nemo_audio_runtime": "NemoTransformerSoundEncoder",
+            "nemo_audio_vllm": "install_vllm_audio",
+            "nemo_audio_processor": "NemoAudioProcessorAdapter",
+        }.items()
+    )
+    source = modeling_path.read_text()
+    if imports not in source:
+        modeling_path.write_text(source.rstrip() + "\n\n" + imports + "\n")
