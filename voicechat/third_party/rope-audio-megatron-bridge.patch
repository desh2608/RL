+# Copyright (c) 2026, NVIDIA CORPORATION. All rights reserved.
+
+"""Native vLLM adapters using Bridge's exported trunk-compatible audio runtime."""
+
+from types import SimpleNamespace
+
+import torch
+from torch import nn
+
+from .nemo_audio_runtime import NemoAudioExtractor, NemoTransformerSoundEncoder, config_dict
+
+
+def _is_nemo(config) -> bool:
+    sound = config_dict(config)
+    return sound.get("model_type", sound.get("sound_model_type")) == "nemo_transformer"
+
+
+def _unit_scale_tiler(original_tiler):
+    """Preserve the saved ratio-one geometry in the native Nano processor.
+
+    The pinned native constructor only admits a twofold reduction, although
+    its methods and the native model already use the stored reduction factor.
+    Delegate setup to that constructor and select no reduction for ratio one.
+    """
+
+    class BridgeDynamicResolutionImageTiler(original_tiler):
+        def __init__(self, *, downsample_ratio, **kwargs):
+            unit_scale = downsample_ratio == 1.0
+            super().__init__(downsample_ratio=0.5 if unit_scale else downsample_ratio, **kwargs)
+            if unit_scale:
+                if self._downsample_ratio != 2:
+                    raise RuntimeError("Unexpected native Nano tiler reduction contract")
+                self._downsample_ratio = 1
+
+    return BridgeDynamicResolutionImageTiler
+
+
+class VllmNemoAudioExtractor(NemoAudioExtractor):
+    """Supply native vLLM mel fields using the same frontend as the learner."""
+
+    def __call__(self, waveforms, *, device: str = "cpu") -> dict:
+        result = super().__call__(waveforms, device=device)
+        frames = result["sound_clips"].shape[1]
+        lengths = result["sound_length"]
+        mask = torch.arange(frames, device=lengths.device)[None, :] < lengths[:, None]
+        return {
+            "input_audio_features": result["sound_clips"],
+            "feature_attention_mask": mask,
+            "audio_num_clips": [1] * len(waveforms),
+        }
+
+    @staticmethod
+    def audio_length(config, audio_tokens: int) -> int:
+        extractor = NemoAudioExtractor(config)
+        frames = audio_tokens * extractor.encoder_config.encoder_time_stride
+        return extractor.feature_config.min_num_samples_for_num_frames(frames)
+
+
+class ProjectedNemoTransformer(nn.Module):
+    """Use the native vLLM sound projection with trunk-compatible encoder keys."""
+
+    def __init__(self, config, *, dtype, llm_hidden_size: int, max_model_len: int) -> None:
+        super().__init__()
+        from vllm.model_executor.models.parakeet import ParakeetProjection
+
+        del max_model_len
+        self.encoder = NemoTransformerSoundEncoder(config).to(dtype)
+        sound = config_dict(config)
+        sound["llm_hidden_size"] = llm_hidden_size
+        sound["projection_eps"] = sound.get("projection_eps", 1e-5)
+        sound["projection_bias"] = sound.get("projection_bias", False)
+        self.projection = ParakeetProjection(SimpleNamespace(**sound)).to(dtype)
+
+    def forward(self, input_features: torch.Tensor, attention_mask: torch.Tensor | None = None) -> torch.Tensor:
+        states, _ = self.encoder(input_features, attention_mask)
+        return self.projection(states.to(next(self.projection.parameters()).dtype))
+
+    def load_weights(self, weights) -> set[str]:
+        """Accept the exact HF names emitted during full export and RL refit."""
+        from vllm.model_executor.model_loader.weight_utils import default_weight_loader
+
+        targets = dict(self.named_parameters()) | dict(self.named_buffers())
+        loaded = set()
+        for name, weight in weights:
+            if name.startswith("sound_encoder."):
+                target_name = "encoder." + name.removeprefix("sound_encoder.")
+            elif name.startswith("sound_projection."):
+                target_name = "projection." + name.removeprefix("sound_projection.")
+            else:
+                raise ValueError(f"Unexpected sound weight {name!r}")
+            if target_name not in targets:
+                raise ValueError(f"Unknown sound weight {name!r}")
+            target = targets[target_name]
+            with torch.no_grad():
+                getattr(target, "weight_loader", default_weight_loader)(target, weight)
+            loaded.add(target_name)
+        return loaded
+
+
+def install_vllm_audio() -> None:
+    """Register architecture dispatch in the native Nano Nemotron vLLM path.
+
+    Call in the engine process and each model worker before construction. Existing
+    Parakeet configs construct their original classes. No checkpoint conversion
+    takes place here; all HF weight names come from Bridge's mapping registry.
+    """
