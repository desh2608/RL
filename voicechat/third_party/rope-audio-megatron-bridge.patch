+class BridgeNemoTransformerSoundEncoder(MegatronModule):
+    """Adapt trunk's NeMo tower to the existing Bridge sound/length interface."""
+
+    def __init__(self, sound_config: dict):
+        from types import SimpleNamespace
+
+        from megatron.core.models.audio.nemo_transformer_audio_model import (
+            NemoTransformerAudioConfig,
+            NemoTransformerAudioModel,
+        )
+
+        from .hf_audio.nemo_audio_runtime import audio_configs
+
+        hf_encoder_config, preprocessor_config = audio_configs(sound_config)
+        config = SimpleNamespace(
+            sound_model_type="nemo_transformer",
+            sound_pad_to_clip_duration=False,
+            sound_batch_split=1,
+        )
+        super().__init__(config=config)
+        self.preprocessor_config = preprocessor_config
+        encoder_config = NemoTransformerAudioConfig.from_dict(vars(hf_encoder_config))
+        self.audio_model = NemoTransformerAudioModel(encoder_config)
+        for parameter in self.audio_model.parameters():
+            parameter.average_gradients_across_tp_domain = True
+
+    def train(self, mode: bool = True):
+        """Keep a frozen tower deterministic when its parent enters training mode."""
+        if not any(parameter.requires_grad for parameter in self.audio_model.parameters()):
+            mode = False
+        return super().train(mode)
+
+    def set_input_tensor(self, input_tensor) -> None:
+        """Supply the pipeline-parallel hook used by sound modules."""
+        self.input_tensor = input_tensor
+
+    def forward(self, sound_clips: torch.Tensor, sound_length: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+        """Encode mel frames with trunk's validity-mask contract."""
+        from .hf_audio.nemo_audio_runtime import validate_mel_lengths
+
+        mask = validate_mel_lengths(sound_clips, sound_length)
+        embeddings, output_mask = self.audio_model(sound_clips, mask)
+        return embeddings, output_mask.sum(-1, dtype=torch.long)
