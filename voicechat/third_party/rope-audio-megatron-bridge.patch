+# Copyright (c) 2026, NVIDIA CORPORATION. All rights reserved.
+
+"""Standalone HF/vLLM adapter for the trunk NeMo audio encoder contract."""
+
+from collections.abc import Mapping
+
+import torch
+from torch import nn
+
+from .nemo_audio_config import NemoAudioFeatureConfig, NemoTransformerAudioTokenEstimator
+from .nemo_audio_preprocessing_standalone import AudioToMelSpectrogramPreprocessor
+from .nemo_transformer_audio_model import NemoTransformerAudioConfig, NemoTransformerAudioModel
+
+
+class Float32AudioPreprocessor(AudioToMelSpectrogramPreprocessor):
+    """Move frontend buffers between devices while preserving float32 precision."""
+
+    def _apply(self, fn, recurse: bool = True):
+        def keep_frontend_dtype(tensor):
+            target = fn(tensor)
+            return tensor.to(device=target.device) if tensor.is_floating_point() else target
+
+        return super()._apply(keep_frontend_dtype, recurse=recurse)
+
+
+def config_dict(config) -> dict:
+    """Normalize checkpoint config objects without inventing architecture fields."""
+    if isinstance(config, Mapping):
+        return dict(config)
+    if hasattr(config, "to_dict"):
+        return config.to_dict()
+    return vars(config).copy()
+
+
+def audio_configs(config) -> tuple[NemoTransformerAudioConfig, NemoAudioFeatureConfig]:
+    """Validate the checkpoint's encoder and frontend contract."""
+    sound = config_dict(config)
+    for field in ("encoder_config", "preprocessor_config"):
+        if not sound.get(field):
+            raise ValueError(f"nemo_transformer requires a non-empty {field}")
+    encoder = NemoTransformerAudioConfig.from_dict(config_dict(sound["encoder_config"]))
+    frontend = NemoAudioFeatureConfig.from_dict(config_dict(sound["preprocessor_config"]))
+    if encoder.architecture == "rope_transformer":
+        for field, expected in (
+            ("attn_impl", "te"),
+            ("pre_encode", "stacking"),
+            ("stacking_pad_mode", "zeros"),
+            ("self_attention_model", "rope"),
+        ):
+            if getattr(encoder, field) != expected:
+                raise ValueError(f"rope_transformer requires {field}={expected!r}")
+    if frontend.features != encoder.n_mels:
+        raise ValueError("preprocessor features must equal encoder n_mels")
+    if sound.get("hidden_size", encoder.d_model) != encoder.d_model:
+        raise ValueError("sound hidden_size must equal encoder d_model")
+    if sound.get("sampling_rate", frontend.sample_rate) != frontend.sample_rate:
+        raise ValueError("sound sampling_rate must equal preprocessor sample_rate")
+    return encoder, frontend
+
+
+def validate_mel_lengths(features: torch.Tensor, lengths: torch.Tensor) -> torch.Tensor:
+    """Validate the Parakeet-compatible mel/length interface and create its mask."""
+    if features.ndim != 3:
+        raise ValueError("sound_clips must have shape [batch, frames, mel_bins]")
+    if lengths.ndim != 1 or lengths.numel() != features.shape[0]:
+        raise ValueError("sound_length must contain one valid frame count per sample")
+    if lengths.dtype not in (torch.uint8, torch.int8, torch.int16, torch.int32, torch.int64):
+        raise ValueError("sound_length must use an integral dtype")
+    if lengths.device != features.device:
+        raise ValueError("sound_length and sound_clips must be on the same device")
+    valid = torch.all((lengths > 0) & (lengths <= features.shape[1]))
+    if features.is_cuda:
+        torch._assert_async(valid, "sound_length must satisfy 0 < length <= physical width")
+    elif not bool(valid):
+        raise ValueError("sound_length must satisfy 0 < length <= physical width")
+    return torch.arange(features.shape[1], device=features.device)[None, :] < lengths[:, None]
+
+
+def materialize_waveforms(preprocessor, waveforms) -> dict[str, torch.Tensor]:
+    """Match MCore's per-waveform frontend, then batch valid mel frames.
+
+    MCore's NemoAudioProcessor materializes one waveform at a time. In
+    particular, fixed_mean/fixed_std checkpoint statistics are feature vectors,
+    not batch-sized arrays accepted by the vendored normalization function.
+    """
+    if not waveforms or any(wave.ndim != 1 or wave.numel() == 0 for wave in waveforms):
+        raise ValueError("Expected one or more nonempty mono waveforms")
+    device = waveforms[0].device
+    preprocessor.to(device=device, dtype=torch.float32)
+    features, lengths = [], []
+    with torch.no_grad():
+        for waveform in waveforms:
+            sample_lengths = torch.tensor([waveform.numel()], device=device, dtype=torch.long)
+            mel, mel_length = preprocessor(waveform.float().unsqueeze(0), sample_lengths)
+            length = int(mel_length[0].item())
+            if length <= 0:
+                raise ValueError("Audio is too short to produce a valid mel frame")
+            features.append(mel[0, :, :length].transpose(0, 1).contiguous())
+            lengths.append(length)
+    result = {
+        "sound_clips": nn.utils.rnn.pad_sequence(features, batch_first=True).float(),
+        "sound_length": torch.tensor(lengths, device=device, dtype=torch.long),
+    }
+    validate_mel_lengths(result["sound_clips"], result["sound_length"])
+    return result
+
+
+class NemoAudioExtractor:
+    """Deterministic trunk frontend shared by learner processing and vLLM."""
+
+    def __init__(self, config) -> None:
+        self.encoder_config, self.feature_config = audio_configs(config)
+        self.sampling_rate = self.feature_config.sample_rate
+        self.model_input_names = ["sound_clips", "sound_length"]
+        self.preprocessor = Float32AudioPreprocessor(**self.feature_config.to_nemo_kwargs()).eval()
+        self.estimator = NemoTransformerAudioTokenEstimator(
+            encoder_time_stride=self.encoder_config.encoder_time_stride,
+            pre_encode=self.encoder_config.pre_encode,
+        )
+
+    def to_dict(self) -> dict:
+        """Expose the sampling rate to generic multimodal loaders."""
+        return {"sampling_rate": self.sampling_rate}
+
+    def audio_token_count(self, num_samples: int) -> int:
+        """Count valid embeddings; suffix batch padding never creates tokens."""
+        frames = self.feature_config.estimate_num_frames(num_samples)
+        count = self.estimator.estimate_from_num_frames(frames)
+        if count <= 0:
+            raise ValueError("Audio is too short to produce an encoder embedding")
+        return count
+
+    def __call__(self, waveforms, *, device: str = "cpu") -> dict[str, torch.Tensor]:
+        """Materialize padded float32 mel tensors with exact valid lengths."""
+        waves = [torch.as_tensor(wave, dtype=torch.float32, device=device) for wave in waveforms]
+        return materialize_waveforms(self.preprocessor, waves)
+
+
+class NemoTransformerSoundEncoder(nn.Module):
+    """HF encoder with the same module keys and computation as trunk MCore."""
+
+    def __init__(self, config) -> None:
+        super().__init__()
+        self.config, self.preprocessor_config = audio_configs(config)
+        self.preprocessor = Float32AudioPreprocessor(**self.preprocessor_config.to_nemo_kwargs()).eval()
+        self.audio_model = NemoTransformerAudioModel(self.config)
+
+    def train(self, mode: bool = True):
+        super().train(mode)
+        self.preprocessor.eval()
+        return self
+
+    def forward(self, sound_clips: torch.Tensor, sound_length: torch.Tensor | None = None):
+        """Encode raw waveforms or preprocessed mels, returning states and lengths."""
+        if sound_clips.ndim == 2:
+            if sound_length is None:
+                sound_length = torch.full(
+                    (sound_clips.shape[0],), sound_clips.shape[1], device=sound_clips.device, dtype=torch.long
+                )
+            elif sound_length.ndim == 2:
+                sound_length = sound_length.sum(-1, dtype=torch.long)
+            if sound_length.ndim != 1 or sound_length.numel() != sound_clips.shape[0]:
+                raise ValueError("Expected one raw waveform length per sample")
+            if bool(torch.any((sound_length <= 0) | (sound_length > sound_clips.shape[1]))):
+                raise ValueError("Raw waveform lengths must fit the physical sample width")
+            waves = [wave[: int(length.item())] for wave, length in zip(sound_clips, sound_length, strict=True)]
+            processed = materialize_waveforms(self.preprocessor, waves)
+            sound_clips, sound_length = processed["sound_clips"], processed["sound_length"]
+        elif sound_length is not None and sound_length.ndim == 2:
+            sound_length = sound_length.sum(-1, dtype=torch.long)
+        if sound_length is None:
+            sound_length = torch.full(
+                (sound_clips.shape[0],), sound_clips.shape[1], device=sound_clips.device, dtype=torch.long
+            )
+        mask = validate_mel_lengths(sound_clips, sound_length)
+        embeddings, output_mask = self.audio_model(sound_clips, mask)
+        return embeddings, output_mask.sum(-1, dtype=torch.long)
+
+    def _get_subsampling_output_length(self, frame_lengths: torch.Tensor) -> torch.Tensor:
+        """Expose the vLLM Parakeet model's frame-length helper."""
+        return self.audio_model._post_subsample_lengths(frame_lengths, int(frame_lengths.max().item()))
+
+    @property
+    def hidden_size(self) -> int:
+        return self.config.output_embedding_dim
+
+    @property
+    def device(self) -> torch.device:
+        return next(self.audio_model.parameters()).device
+
+
+# Direct imports make local Transformers dynamic-module reload self-contained.
+from .nemo_audio_config import NemoAudioFeatureConfig as _BridgeNemoAudioFeatureConfig  # noqa: E402, F401
+from .nemo_audio_preprocessing_standalone import (
+    AudioToMelSpectrogramPreprocessor as _BridgeAudioToMelSpectrogramPreprocessor,  # noqa: E402, F401
+)
+from .nemo_rope_transformer_encoder import RopeTransformerEncoder as _BridgeRopeTransformerEncoder  # noqa: E402, F401
+from .nemo_transformer_audio_model import NemoTransformerAudioModel as _BridgeNemoTransformerAudioModel  # noqa: E402, F401
+from .nemo_transformer_encoder import TransformerEncoder as _BridgeTransformerEncoder  # noqa: E402, F401
+from .packed_audio import PackedAudioEmbeddings as _BridgePackedAudioEmbeddings  # noqa: E402, F401
