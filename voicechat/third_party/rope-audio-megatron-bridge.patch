+            return constructor.audio_length(config, audio_tokens)
+
+    sound_module.ProjectedParakeet = model_module.ProjectedParakeet = SoundEncoderDispatch
+    sound_module.ParakeetExtractor = model_module.ParakeetExtractor = AudioExtractorDispatch
+    processor_module.ParakeetExtractor = AudioExtractorDispatch
+    processor_module.DynamicResolutionImageTiler = _unit_scale_tiler(processor_module.DynamicResolutionImageTiler)
+    sound_module._bridge_nemo_audio_installed = True
